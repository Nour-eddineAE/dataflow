          "rawSql": "SELECT formatDateTime(day, '%m-%d') AS d, sumIf(events, magnitudeBand = '1 micro (<2)') AS `1 micro (<2)`, sumIf(events, magnitudeBand = '2 minor (2-4)') AS `2 minor (2-4)`, sumIf(events, magnitudeBand = '3 light (4-5)') AS `3 light (4-5)`, sumIf(events, magnitudeBand = '4 moderate (5-6)') AS `4 moderate (5-6)`, sumIf(events, magnitudeBand = '5 strong (6+)') AS `5 strong (6+)` FROM serving.earthquakes_daily_activity GROUP BY day ORDER BY day",
