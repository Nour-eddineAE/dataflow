      },
      "id": 16,
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Flows",
      "description": "Each flow of the run, in start order. A failed flow skips everything downstream.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dataflow-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dataflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT started_at AS started, flow, status, round(dateDiff('millisecond', started_at, ended_at) / 1000, 2) AS seconds, rows_in, rows_out, rows_dropped, JSONExtractString(details, 'error') AS error FROM serving.run_events WHERE run_id = '${run}' AND event_type = 'flow_progress' ORDER BY started_at, flow",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "COMPLETED": {
                        "text": "completed",
                        "color": "#73BF69",
                        "index": 0
                      },
                      "FAILED": {
                        "text": "failed",
                        "color": "#F2495C",
                        "index": 1
                      },
                      "SKIPPED": {
                        "text": "skipped",
                        "color": "#8E8E8E",
                        "index": 2
                      },
                      "RUNNING": {
                        "text": "running",
                        "color": "#8AB8FF",
                        "index": 3
                      },
                      "STALLED": {
                        "text": "stalled",
                        "color": "#FADE2A",
                        "index": 4
                      },
                      "CANCELED": {
                        "text": "canceled",
                        "color": "#8E8E8E",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [],
        "footer": {
          "show": false
        }
      },
      "id": 17,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "barchart",
      "title": "Flow time",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dataflow-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dataflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT flow, dateDiff('millisecond', started_at, ended_at) / 1000 AS seconds FROM serving.run_events WHERE run_id = '${run}' AND event_type = 'flow_progress' AND status != 'SKIPPED' ORDER BY started_at",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0,
        "barWidth": 0.8,
        "groupWidth": 0.7
      },
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Expectations",
      "description": "Every expectation of the run: rows that broke it, and what the spec does with them.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dataflow-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dataflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT JSONExtractString(details, 'expectation') AS expectation, JSONExtractString(details, 'action') AS action, rows_dropped AS failing_rows, rows_in AS evaluated, JSONExtractBool(details, 'passed') AS passed, JSONExtractString(details, 'check') AS `check` FROM serving.run_events WHERE run_id = '${run}' AND event_type = 'expectation' ORDER BY expectation",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "passed"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "passed",
                        "color": "#73BF69"
                      },
                      "false": {
                        "text": "failing",
                        "color": "#FADE2A"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [],
        "footer": {
          "show": false
        }
      },
      "id": 19,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Details",
      "description": "Raw event log entries of the run (details is JSON).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dataflow-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dataflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT event_type, flow, details FROM serving.run_events WHERE run_id = '${run}' ORDER BY ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
