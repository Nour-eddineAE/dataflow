    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "dataflow-clickhouse"
        },
        "query": "SELECT run_id FROM serving.run_events WHERE event_type = 'run' GROUP BY run_id ORDER BY min(ts) DESC LIMIT 200",
        "definition": "recent runs",
        "refresh": 2,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Runs",
        "enable": true,
        "iconColor": "rgba(184, 119, 217, 0.55)",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "dataflow-clickhouse"
        },
        "target": {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dataflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "refId": "Anno",
          "rawSql": "SELECT started_at AS time, ended_at AS timeEnd, concat(dataset, ' · ', lower(status), ' · ', trigger) AS text FROM serving.run_events WHERE event_type = 'run' AND status IN ('COMPLETED', 'FAILED') AND $__timeFilter(started_at)"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Pipeline",
      "type": "dashboards",
      "tags": [
        "pipeline"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Dataset",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dataflow-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dataflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT any(dataset) FROM serving.run_events WHERE run_id = '${run}'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8AB8FF"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8AB8FF",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Status",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dataflow-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dataflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT multiIf('${run}' IN (SELECT run_id FROM serving.run_verdicts FINAL WHERE status = 'FAILED'), 'FAILED', '${run}' IN (SELECT run_id FROM serving.run_verdicts FINAL WHERE status = 'CANCELED'), 'CANCELED', countIf(event_type = 'run' AND status = 'FAILED') > 0, 'FAILED', countIf(event_type = 'run' AND status = 'COMPLETED') > 0, 'COMPLETED', 'RUNNING') FROM serving.run_events WHERE run_id = '${run}'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8AB8FF"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8AB8FF",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 13,
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Duration",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dataflow-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dataflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT dateDiff('millisecond', minIf(started_at, event_type = 'run'), maxIf(ended_at, event_type = 'run')) / 1000 FROM serving.run_events WHERE run_id = '${run}'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8AB8FF"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8AB8FF",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
