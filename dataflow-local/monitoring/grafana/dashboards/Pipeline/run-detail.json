{
  "uid": "dataflow-run",
  "title": "Pipeline · Run detail",
  "description": "One run, flow by flow, from the event log.",
  "tags": [
    "dataflow",
    "pipeline"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
