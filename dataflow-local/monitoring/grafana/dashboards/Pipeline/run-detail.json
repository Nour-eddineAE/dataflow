    {
      "type": "stat",
      "title": "Partition",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dataflow-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dataflow-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT ifNull(anyIf(partition, event_type = 'run'), '—') FROM serving.run_events WHERE run_id = '${run}'",
          "refId": "A"
