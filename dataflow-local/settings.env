# Settings of the local stack. Secrets live in .env, written by `./dataflow init`.
# A value set in .env wins over the one here.

# Where the other checkouts are
PLATFORM_DIR=${PWD}/../dataflow-platform
REMOTES_DIR=${PWD}/../remotes
DATA_DIR=${PWD}/data

# Ports on this machine
WORKSPACE_PORT=3080
TOWER_PORT=3070
GRAFANA_PORT=3000
MAILPIT_PORT=8025
KEYCLOAK_PORT=8180
RUSTFS_PORT=9100
RUSTFS_CONSOLE_PORT=9101
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9009
POSTGRES_PORT=5432
SPARK_HISTORY_PORT=18080

# Addresses browsers use
WORKSPACE_URL=http://localhost:${WORKSPACE_PORT}
ISSUER=http://localhost:${KEYCLOAK_PORT}/realms/dataflow
# Spark UI for administrators: http://localhost:${SPARK_HISTORY_PORT} while `./dataflow up spark-history` runs, else empty
SPARK_HISTORY_LINK=

# Sign-in sessions, in seconds: idle and longest; "Keep me signed in" uses the second pair
SESSION_IDLE_SECONDS=604800
SESSION_MAX_SECONDS=2592000
REMEMBER_ME_IDLE_SECONDS=2592000
REMEMBER_ME_MAX_SECONDS=7776000

# Google sign-in shows once GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are in .env; a domain here limits it to that Google Workspace
GOOGLE_HOSTED_DOMAIN=

# Image versions
POSTGRES_VERSION=16.8
CLICKHOUSE_VERSION=26.10.2
RUSTFS_VERSION=1.0.4
KEYCLOAK_VERSION=26.7.5
OAUTH2_PROXY_VERSION=v7.15.5
GRAFANA_VERSION=11.4.0
MAILPIT_VERSION=v1.31.4
CURL_VERSION=8.11.1
SOCAT_VERSION=1.8.1.1
SPARK_VERSION=4.2.0
HADOOP_VERSION=3.5.0
AWS_SDK_VERSION=2.35.4

# Memory limits (the Docker VM has 5 GB; the idle stack uses about 2 GB and a run up to ENGINE_MEMORY more).
# tower-code also holds one run worker per running run (about 60 MB each).
ENGINE_MEMORY=1800m
TASK_MEMORY=1200m
WORKSPACE_MEMORY=640m
TOWER_CODE_MEMORY=512m
TOWER_WEBSERVER_MEMORY=384m
TOWER_DAEMON_MEMORY=320m

# The most one run may ask for (compute in dataflow.yml or a pipeline.yml): the Workspace refuses larger edits and the
# tower lowers older releases to fit. Empty means no limit; executor limits apply on Kubernetes only.
COMPUTE_MAX_DRIVER_MEMORY=2g
COMPUTE_MAX_DRIVER_CORES=4
COMPUTE_MAX_EXECUTOR_MEMORY=
COMPUTE_MAX_EXECUTOR_CORES=
COMPUTE_MAX_EXECUTORS=

# Allow the local code-server child to survive a week of laptop sleep (seconds).
TOWER_CODE_HEARTBEAT_TTL_SECONDS=604800

# Project Workspace dataset grants into RustFS; migrate only this install's old console policies.
STORAGE_ACCESS_ENABLED=true
STORAGE_LEGACY_POLICIES=readonly,readwrite
CLICKHOUSE_MEMORY=1g
RUSTFS_MEMORY=320m
KEYCLOAK_MEMORY=768m
GRAFANA_MEMORY=256m
SPARK_HISTORY_MEMORY=256m

# Names
LAKE_BUCKET=lake
RELEASES_BUCKET=releases
RELEASES_TARGET=prod
POSTGRES_USER=dataflow
CLICKHOUSE_USER=dataflow
CLICKHOUSE_DB=serving
PERSON_ID=local
PERSON_NAME=DataFlow Workspace
PERSON_EMAIL=workspace@dataflow.local

# Engine
ENGINE_MAINTENANCE_INTERVAL=1h
ENGINE_MAINTENANCE_RETENTION_HOURS=168
ENGINE_SOURCE_TIMEOUT=10m
ENGINE_SOURCE_CONNECT_TIMEOUT=30s
ENGINE_SERVING_TIMEOUT=10m
ENGINE_SERVING_CONNECT_TIMEOUT=10s
SMTP_TIMEOUT=30
SPARK_SQL_SHUFFLE_PARTITIONS=8
SPARK_DELTA_SNAPSHOT_PARTITIONS=4
SPARK_EVENT_LOG_ENABLED=true

# Alert mail: Mailpit keeps every message; set the relay to forward them to a real mailbox
ALERT_EMAIL=
MAILPIT_RELAY_HOST=
MAILPIT_RELAY_PORT=587
MAILPIT_RELAY_USERNAME=
MAILPIT_RELAY_RECIPIENTS=
