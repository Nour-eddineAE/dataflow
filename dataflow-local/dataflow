#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

readonly passwords=(
  JASYPT_ENCRYPTOR_PASSWORD POSTGRES_PASSWORD CLICKHOUSE_PASSWORD RUSTFS_ACCESS_KEY RUSTFS_SECRET_KEY
  KEYCLOAK_ADMIN_PASSWORD PERSON_INITIAL_PASSWORD RUSTFS_CONSOLE_CLIENT_SECRET SIGN_IN_PROXY_CLIENT_SECRET
  SIGN_IN_PROXY_COOKIE_SECRET GRAFANA_ADMIN_PASSWORD
)
readonly encrypted=(CLICKHOUSE_PASSWORD RUSTFS_SECRET_KEY)

usage() {
  cat >&2 <<'EOF'
usage: ./dataflow <command>

  init                write the secrets this stack needs into .env (keeps existing ones)
  up | down | restart start or stop the stack
  status              list the services
  logs [service...]   follow logs
  build [image...]    build engine, workspace, tower, engine-k8s or tower-k8s from ../dataflow-platform (all but the
                      Kubernetes images when none)
  run <dataset> [partition]
                      queue a run in the tower, like Run now in the Workspace
  engine <arguments>  run the engine directly, outside the tower's queue (debugging only):
                      run --dataset=<id> --release=<project>@<commit> [--partition=<key>]
  encrypt <value>     print ENC(...) of a value, for settings read by the engine and the Workspace
  prune               remove dangling DataFlow images
EOF
  exit 2
}

compose() {
  [[ -f .env ]] || { echo "No .env yet: run ./dataflow init" >&2; exit 1; }
  docker compose --env-file settings.env --env-file .env "$@"
}

secret() {
  sed -n "s/^$1=//p" .env
}

java_bin() {
  if command -v java >/dev/null; then
    command -v java
  else
    echo "$(/usr/libexec/java_home -v 21)/bin/java"
  fi
}

encrypt() {
  local jar key
  jar=$(find "$HOME/.m2/repository/org/jasypt/jasypt" -name 'jasypt-*.jar' ! -name '*-sources.jar' 2>/dev/null | sort -V | tail -1)
  [[ -n $jar ]] || { echo "Jasypt not found in ~/.m2: build dataflow-platform once" >&2; exit 1; }
  key=$(secret JASYPT_ENCRYPTOR_PASSWORD)
  printf 'ENC(%s)\n' "$("$(java_bin)" -cp "$jar" org.jasypt.intf.cli.JasyptPBEStringEncryptionCLI verbose=false \
    input="$1" password="$key" algorithm=PBEWITHHMACSHA512ANDAES_256 \
    ivGeneratorClassName=org.jasypt.iv.RandomIvGenerator | tr -d '[:space:]')"
}

init() {
  umask 077
  touch .env
  local name
  for name in "${passwords[@]}"; do
    [[ -n $(secret "$name") ]] || printf '%s=%s\n' "$name" "$(openssl rand -hex 16)" >> .env
  done
  for name in "${encrypted[@]}"; do
    [[ -n $(secret "${name}_ENC") ]] || printf '%s_ENC=%s\n' "$name" "$(encrypt "$(secret "$name")")" >> .env
  done
  echo "Secrets are in .env"
}

run() {
  local dataset=${1:-} partition=${2:-}
  [[ $dataset =~ ^[a-z][a-z0-9_]*$ ]] || usage
  local tags="{\"triggered-by\": \"dataflow-local\"${partition:+, \"dagster/partition\": \"$partition\"}}"
  compose exec -T tower-webserver sh -c 'dagster job launch -w "$DAGSTER_HOME/workspace.yaml" -j "$1" --tags "$2"' \
    launch "${dataset}_job" "$tags"
  echo "Queued ${dataset}_job; follow it on the Workspace's Runs page"
}

build() {
  local images=("$@")
  (( ${#images[@]} )) || images=(engine workspace tower)
  local image
  for image in "${images[@]}"; do
    case $image in
      engine) compose --profile engine build engine ;;
      workspace) compose build workspace && compose up -d workspace ;;
      tower) compose build tower-code && compose up -d --force-recreate tower-code tower-webserver tower-daemon ;;
      engine-k8s) docker build --target engine-k8s -t dataflow-engine-k8s:latest ../dataflow-platform ;;
      tower-k8s) docker build --build-arg EXTRAS=kubernetes -t dataflow-tower-k8s:latest ../dataflow-platform/tower ;;
      *) usage ;;
    esac
  done
}

command=${1:-}
(( $# )) && shift
case $command in
  init) init ;;
  up) mkdir -p data && compose up -d --remove-orphans "$@" ;;
  down) compose down ;;
  restart) compose down && compose up -d ;;
  status) compose ps ;;
  logs) compose logs -f "$@" ;;
  build) build "$@" ;;
  run) run "$@" ;;
  engine) compose --profile engine run --rm engine "$@" ;;
  encrypt) (( $# == 1 )) || usage; encrypt "$1" ;;
  prune) docker image prune --force --filter label=org.dataflow.component ;;
  *) usage ;;
esac
